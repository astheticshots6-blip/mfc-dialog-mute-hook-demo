#include <windows.h>
#include <winres.h>
#include "resource.h"

IDD_MAINDLG DIALOGEX 0, 0, 260, 180
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Dialog Mute Demo"
FONT 9, "MS Shell Dlg"
BEGIN
    CONTROL "Show a Modal Dialog", IDC_SHOW_MODAL, "Button", WS_TABSTOP | WS_VISIBLE | WS_CHILD, 20, 30, 160, 30
    CONTROL "Toggle Mute", IDC_TOGGLE_MUTE, "Button", WS_TABSTOP | WS_VISIBLE | WS_CHILD, 20, 80, 160, 30
    DEFPUSHBUTTON "Close", IDCANCEL, 20, 130, 80, 24
END
